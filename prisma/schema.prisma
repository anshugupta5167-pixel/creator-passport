// Creator Passport Prisma Schema
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum CreatorRole {
  CREATOR
  FOUNDING_CREATOR
  PARTNER
  ADMIN
}

model User {
  id            String       @id @default(uuid())
  email         String?      @unique
  discordId     String?      @unique
  youtubeId     String?      @unique
  role          CreatorRole  @default(CREATOR)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  creator       Creator?
  sessions      Session[]
  auditLogs     AuditLog[]
}

model Creator {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  username        String       @unique // e.g. "itsuniqueplayz"
  displayName     String       // e.g. "ItsUniquePlayz"
  avatarUrl       String?
  bio             String?
  category        String       // e.g. "Gaming Creator", "Tech & AI"
  country         String?      @default("United States")
  location        String?      // e.g. "San Francisco, CA"
  skills          String[]     @default([])
  featuredVideos  Json?        @default("[]") // Portfolio items
  isSuspended     Boolean      @default(false)
  suspensionReason String?
  profileCompletion Int       @default(85)
  contactEmail    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  passport        Passport?
  connections     PlatformConnection[]
  verifications   Verification[]
  proofDocuments  ProofDocument[]
  achievements    CreatorAchievement[]
  collaborations  Collaboration[]
}

model Passport {
  id              String             @id @default(uuid())
  creatorId       String             @unique
  creator         Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  slug            String             @unique // URL slug e.g. "itsuniqueplayz" — used for public URLs
  issueNumber     Int                @unique
  status          VerificationStatus @default(PENDING)
  isFounding      Boolean            @default(true)
  tierName        String             @default("Founding Member Tier I")
  cryptographicHash String           @unique // SHA-256 digital stamp
  issuedAt        DateTime           @default(now())
  lastVerifiedAt  DateTime           @default(now())
  qrCodeUrl       String?
}

model PlatformConnection {
  id              String       @id @default(uuid())
  creatorId       String
  creator         Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform        String       // "YOUTUBE", "DISCORD", "TWITCH", "X", "INSTAGRAM" etc.
  platformUserId  String       // e.g. Discord snowflake or YouTube channel ID
  username        String
  displayName     String?
  metricLabel     String       // "subscribers", "members", "followers"
  metricValue     String       // "184K", "12.4K"
  metricRaw       Int          @default(0)
  verified        Boolean      @default(true)
  profileUrl      String?
  connectedAt     DateTime     @default(now())
  lastSyncedAt    DateTime     @default(now())

  @@unique([platform, platformUserId])
}

model Verification {
  id              String             @id @default(uuid())
  creatorId       String
  creator         Creator            @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  platform        String             // "DISCORD", "YOUTUBE", "IDENTITY"
  status          VerificationStatus @default(PENDING)
  proofHash       String?
  submittedData   Json?
  reviewerNote    String?
  rejectionReason String?
  verifiedAt      DateTime?
  reviewedAt      DateTime?
  reviewedBy      String?            // Admin who reviewed
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model ProofDocument {
  id              String       @id @default(uuid())
  creatorId       String
  creator         Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  filename        String       // Original filename
  storagePath     String       // Secure server path (never exposed publicly)
  mimeType        String       @default("image/png")
  fileSizeBytes   Int          @default(0)
  platform        String?      // Which platform this proof is for
  notes           String?      // Creator notes about this proof
  uploadedAt      DateTime     @default(now())

  @@index([creatorId])
}

model Achievement {
  id              String       @id @default(uuid())
  slug            String       @unique // "founding-creator", "verified-creator", "100k-subs"
  name            String       // "Founding Creator"
  description     String
  badgeIcon       String       // "shield-check", "sparkles", "trophy"
  category        String       // "MILESTONE", "MEMBERSHIP", "COMMUNITY"

  creators        CreatorAchievement[]
}

model CreatorAchievement {
  id              String       @id @default(uuid())
  creatorId       String
  creator         Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     Achievement  @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt      DateTime     @default(now())

  @@unique([creatorId, achievementId])
}

model Collaboration {
  id                  String    @id @default(uuid())
  creatorId           String
  creator             Creator   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  partnerHandle       String    // e.g. "@sarahchen" — use handles, not IDs
  partnerName         String    // e.g. "Sarah Chen"
  partnerAvatar       String?
  title               String    // e.g. "AI Gameplay Benchmark Stream"
  category            String    // e.g. "Co-Stream", "Sponsorship", "Guest Appearance"
  projectUrl          String?
  collabDate          DateTime  @default(now())
  verified            Boolean   @default(true)
}

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String    // "VERIFICATION_APPROVED", "PROFILE_SUSPENDED", etc.
  actorEmail    String?
  details       Json?
  ipAddress     String?
  createdAt     DateTime  @default(now())
}
