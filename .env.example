# Creator Passport Environment Configuration
# Production & Local Setup

# Base App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas persistent database
MONGODB_URI=
MONGODB_DB_NAME=creatorhq

# Optional legacy GitHub Gist sync for local development only. MongoDB is authoritative when configured.
GITHUB_DATA_TOKEN=

# Discord OAuth & Single Bot Integration
DISCORD_CLIENT_ID=123456789012345678
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Google / YouTube OAuth
YOUTUBE_CLIENT_ID=your_google_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# Security & Sessions
SESSION_SECRET=replace_with_a_unique_random_value_at_least_32_characters
ADMIN_PASSCODE=replace_with_a_private_staff_passcode
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@creatorhq.fun

# Internal API Secret for Discord Bot to API communication
INTERNAL_BOT_API_KEY=replace_with_a_private_random_value

